# Copy to .env and fill in. Never commit real values.

# --- Database (Supabase Postgres with pgvector) ---
# Supabase: Project Settings > Database > Connection string (URI). Include the password.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres"
PGSSL=true
# Optional: path to Supabase's CA certificate (Project Settings > Database > SSL).
# When set, the server certificate is fully verified.
PG_SSL_CA_PATH=

# --- Azure OpenAI (v1 API base URL, e.g. https://<resource>.openai.azure.com/openai/v1) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_LLM_DEPLOYMENT="gpt-4.1"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"
# Must match vector(N) in src/data/migrations/001_init.sql (text-embedding-3-small = 1536)
EMBEDDING_DIMENSIONS=1536

# --- Server ---
PORT=4000
# React dev server origin(s), comma-separated
CORS_ORIGIN="http://localhost:5173"

# --- Limits (optional, defaults shown) ---
MAX_UPLOAD_MB=50
MAX_FILE_KB=1024
MAX_FILES_PER_SOURCE=5000
ALLOWED_GIT_HOSTS="github.com,gitlab.com,bitbucket.org,dev.azure.com"
QUERY_TOP_K=8
